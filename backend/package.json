{
    "name": "backendsqlite",
    "version": "1.0.0",
    "description": "backendsqlite is the ultimate backend solution",
    "main": "src/server.js",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "setup": "npm install && npm run doc && npm run db:reset",
        "updatedb": "node src/util/updatedb.js",
        "db:reset": "DB_RESET=true DB_SEED=true npm run updatedb",
        "db:seed": "DB_SEED=true npm run updatedb",
        "doc": "node src/util/swagger.js",
        "start:prod": "node src/server.js",
        "start": "npm run doc && DB_LOG=true npm run updatedb && node src/server.js",
        "startdev": "npm run doc && DB_LOG=true npm run updatedb && npx nodemon src/server.js",
        "test": "./setup-test.sh && DB_NAME=messaging_test NODE_ENV=test jest --coverage",
        "migrate": "npx sequelize-cli db:migrate"
    },
    "keywords": [
        "express",
        "backend",
        "backendsqlite"
    ],
    "license": "UNLICENSED",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.4",
        "cors": "^2.8.5",
        "express": "^5.3.0",
        "has-keys": "^0.1.0",
        "helmet": "^3.21.2",
        "http-status": "^1.3.2",
        "jws": "^4.0.0",
        "mandatoryenv": "^1.1.1",
        "mariadb": "^3.5.4",
        "module-alias": "^2.2.2",
        "morgan": "^1.9.1",
        "pg": "^8.23.0",
        "pg-hstore": "^2.3.4",
        "rotating-file-stream": "^1.4.6",
        "sequelize": "^6.37.8",
        "socket.io": "^4.8.3",
        "sqlite3": "^6.0.1",
        "swagger-autogen": "^2.18.8",
        "swagger-ui-express": "^4.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "jest": "^30.5.1",
        "sequelize-cli": "^6.6.5",
        "supertest": "^7.3.1"
    },
    "//uuid-override": "TEMPORAIRE — Sequelize 6 dépend d'un uuid vulnérable (GHSA-w5hq-g745-h8pq). On force uuid ^11.1.1 (dernière branche CommonJS + patchée) le temps que Sequelize corrige. Voir https://github.com/sequelize/sequelize/issues/18238 — À SUPPRIMER une fois Sequelize à jour (npm audit doit rester clean sans l'override).",
    "overrides": {
        "sequelize": {
            "uuid": "^11.1.1"
        },
        "shell-quote": "1.12.0"
    }
}
