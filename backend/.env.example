# ======================================
#       server (required)
# ======================================
NODE_ENV=development
PORT=3000
TOKENSECRET=change-me-to-a-long-random-secret

# ======================================
#       database — local / test
#       Do NOT set DATABASE_URL outside production
# ======================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=test
DB_NAME=messaging

# ======================================
#       database — production only
# ======================================
# DATABASE_URL=postgres://user:password@host:port/database_name
# DB_SSL=true

# ======================================
#       optional flags (default: false)
# ======================================
# DB_LOG=true
# DB_SSL=false
# DB_RESET=false
# DB_SEED=false
